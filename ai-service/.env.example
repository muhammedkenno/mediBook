# Absolute or relative path to the folder containing the .pkl model files
MODEL_DIR=../AI_Engine_Ready

# URL of the Next.js frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# Shared secret — must match AI_SERVICE_API_KEY in the frontend's .env.local.
# Leave empty to disable auth (local dev only).
AI_SERVICE_API_KEY=change-me-to-a-long-random-string
